# Copie este arquivo para .env e preencha. NUNCA comite o .env.

# --- Outlook ---
# Nome da caixa compartilhada exatamente como aparece no painel esquerdo do Outlook clássico
OUTLOOK_ARMAZENAMENTO=
# Opcional: e-mail da caixa, só necessário se ela NÃO aparecer como conta própria no painel
# (caixa aberta apenas por permissão, sem "automapeamento")
OUTLOOK_EMAIL=
# Domínio dos e-mails internos (usado para reconhecer remetentes internos e e-mails na assinatura)
DOMINIO_INTERNO=@orgao.gov.br
# Categorias do Outlook que não são nomes de estagiário, além de Feito/Em Atendimento/Encaminhamento
# (opcional, separadas por vírgula)
CATEGORIAS_IGNORADAS=

# --- SharePoint ---
# Cliente gravado para demandas externas de Consultas Públicas (pessoa/grupo que o SharePoint reconhece)
CLIENTE_CONSULTAS_PUBLICAS=
# Cliente gravado para demandas externas do portal
CLIENTE_PORTAL_EXTERNO=
# Endereço da lista (abre no navegador ao final da execução; opcional)
LISTA_URL=

# --- IA ---
# Se a chave ficar vazia, o programa pede na primeira execução e a guarda aqui
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
